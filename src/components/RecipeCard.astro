---
interface Props {
  title: string;
  description: string;
  duration: string;
  origin: string;
  href?: string;
}

const { title, description, duration, origin, href } = Astro.props;
---

{
  href ? (
    <a class="recipe-card recipe-card--link" href={href}>
      <div class="recipe-card__stripe" aria-hidden="true"></div>
      <div class="recipe-card__body">
        <h3>{title}</h3>
        <p class="recipe-meta">{origin} · {duration}</p>
        <p>{description}</p>
        <p class="recipe-card__footer">View recipe</p>
      </div>
    </a>
  ) : (
    <article class="recipe-card">
      <div class="recipe-card__stripe" aria-hidden="true"></div>
      <div class="recipe-card__body">
        <h3>{title}</h3>
        <p class="recipe-meta">{origin} · {duration}</p>
        <p>{description}</p>
        <p class="recipe-card__footer">Recipe note</p>
      </div>
    </article>
  )
}
