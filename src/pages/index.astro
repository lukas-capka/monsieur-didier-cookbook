---
import MainLayout from "../layouts/MainLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<MainLayout title="Wave & Vent | Brittany Recipes">
  <HomeHero />

  <section id="recipes" aria-labelledby="recipes-title">
    <h2 class="section-title" id="recipes-title">Featured shoreline recipes</h2>
    <div class="recipe-grid">
      {
        recipes.map((recipe) => (
          <RecipeCard
            href={`recipes/${recipe.id}/`}
            title={recipe.data.title}
            description={recipe.data.description}
            duration={`${recipe.data.prepTime} prep · ${recipe.data.cookTime} cook`}
            origin={recipe.data.region}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
