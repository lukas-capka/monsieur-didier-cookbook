---
import MainLayout from "../../layouts/MainLayout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<MainLayout
  title="Recipes | Monsieur Didier"
  description="Browse Monsieur Didier's coastal French recipes from Brittany and nearby Atlantic ports."
>
  <section class="recipes-page" aria-labelledby="recipes-page-title">
    <h1 id="recipes-page-title">Monsieur Didier Recipes</h1>
    <p class="recipes-page__intro">Traditional dishes from Brittany and nearby Atlantic ports.</p>
    <div class="recipe-grid">
      {
        recipes.map((recipe) => (
          <RecipeCard
            href={`${recipe.id}/`}
            title={recipe.data.title}
            description={recipe.data.description}
            duration={`${recipe.data.prepTime} prep · ${recipe.data.cookTime} cook`}
            origin={recipe.data.region}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
