---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes", ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<MainLayout
  title="Recipes | Monsieur Didier"
  description="Browse Monsieur Didier's coastal French recipes from Brittany and nearby Atlantic ports."
>
  <section aria-labelledby="recipes-page-title">
    <h1 id="recipes-page-title">Monsieur Didier Recipes</h1>
    <p>Traditional dishes from Brittany and nearby Atlantic ports.</p>
    <ul>
      {
        recipes.map((recipe) => (
          <li>
            <article>
              <h2>
                <a href={`${recipe.id}/`}>{recipe.data.title}</a>
              </h2>
              <p>{recipe.data.description}</p>
              <p>
                <strong>Region:</strong> {recipe.data.region}
              </p>
              <p>
                <strong>Prep:</strong> {recipe.data.prepTime} |{" "}
                <strong>Cook:</strong> {recipe.data.cookTime} |{" "}
                <strong>Serves:</strong> {recipe.data.servings}
              </p>
              <p>
                <strong>Tags:</strong> {recipe.data.tags.join(", ")}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
